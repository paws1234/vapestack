# Secrets and machine-specific config; never committed.
.env
.mcp.json

# The state mirror's PostgreSQL connection string, written from the example beside it by
# tools/configure-mirror.sh. It carries a database password, so it stays out of the repository. The
# example beside it does not, and is committed.
mirror/.mirror.env

# Holds the Elementor MCP server's Basic credential in the clear. It is not a placeholder and not
# a hash, it is the credential itself, so it stays out of the repository.
.elementor-mcp-credential

# Claude Code keeps its per-project approvals here.
.claude/settings.local.json

# WordPress runtime state - not project code.
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/debug.log
*.log

# Third-party plugin code. `wpengine/wp-graphql-content-blocks` is what turns Gutenberg blocks into
# GraphQL data; it is pinned and installed by `tools/install-blocks-plugin.sh` rather than vendored
# here, because 63 files of somebody else's PHP are not this project's source. The directory is
# bind-mounted into the container, so a recreate keeps it, and the script reproduces it on a clone.
wp-content/plugins/wp-graphql-content-blocks/

# tools/tunnel.sh keeps the quick tunnel's pid, log and hostname here. Machine-specific and
# regenerated on every start, so it is never committed.
.tunnel/

# tools/fetch-source-products.mjs caches the source shop's raw API responses here, so re-running it
# costs no requests. Derived from the committed fixture and never reviewed, so never committed.
tools/.cache/

# The Vercel CLI's link to this project, and the OIDC token it writes next to it when it links.
# Machine-specific; the project is identified by the repository it is built from.
.vercel/
.env.local

# The storefront is a real app built in place, so keep its dependencies and build output out of
# version control. frontend/.gitignore covers the same ground for its own directory.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*
!frontend/.env.local.example

.DS_Store
Thumbs.db
.vercel
.env*
