# The state mirror's settings. Copy this to `.mirror.env` beside it - or run
# `bash tools/configure-mirror.sh`, which writes it for you and sets the schema up.
#
# The file is read by mirror/state.sh inside the container and by tools/mirror.sh on the host, and
# it is gitignored: it holds a credential.

# A PostgreSQL connection string. Leave it empty and the mirror is off - no export at shutdown, no
# hydration at boot, and the site behaves exactly as it did before this existed.
#
# Supabase works, but use the **shared pooler** host from the Connect dialog, in session mode, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Do not use `db.<ref>.supabase.co`: it publishes only an AAAA record, and these containers have no
# IPv6 route, so the connection fails in a way that looks like a network outage.
MIRROR_DATABASE_URL=

# How many complete snapshots to keep. Each is a full copy of the database and every upload, so this
# is the mirror's entire storage budget - at the time of writing one snapshot is a few MB of dump
# and ~56 MB of base64 uploads.
MIRROR_KEEP=3

# Seconds any single mirror operation may take before it is abandoned. A shutdown waits for the
# export, so this must stay well inside the wordpress service's stop_grace_period (180s).
MIRROR_TIMEOUT=120
