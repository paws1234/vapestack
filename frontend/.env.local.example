# Copy to .env.local and fill in the credentials.
#
# Everything here is read by server code only. Do not add NEXT_PUBLIC_ to the
# WooCommerce credentials: the checkout route holds them so the browser never does.

# This storefront's own origin, used for everything that has to say *where* a page is rather than
# just what it is: canonical links, metadataBase, OpenGraph images and the url fields in JSON-LD.
# It is a NEXT_PUBLIC_ variable because Next inlines it at build time, so a deployment must have
# it set before it builds - setting it afterwards needs a redeploy.
#
# Local development needs nothing: unset, it falls back to http://localhost:3000, the origin
# `next dev` serves. Locally that is correct; in production the fallback is the bug that makes
# /sitemap.xml list 300 routes on localhost, so production sets it to the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress GraphQL endpoint, used for all catalogue reads.
WP_GRAPHQL_URL=http://localhost:8889/graphql

# WooCommerce REST v3 base, used by the checkout route to create orders.
WP_REST_URL=http://localhost:8889/wp-json/wc/v3

# The origin WordPress advertises for its own uploads, and the origin the browser
# should actually load them from. They are the same locally; behind a tunnel
# WP_PUBLIC_URL becomes the tunnel host and image URLs are rewritten in between.
#
# The rewrite matches on host and port and never on the scheme: a TLS-terminating tunnel tells
# WordPress the request arrived over HTTPS, so WordPress advertises `https://localhost:8889/...`
# while WP_INTERNAL_URL here still says `http://`. Matching the scheme is what broke every image
# on the deployed site.
WP_INTERNAL_URL=http://localhost:8889
WP_PUBLIC_URL=http://localhost:8889

# The credential the checkout route authenticates with, sent as HTTP Basic. Either a
# WooCommerce REST key pair, created in wp-admin under WooCommerce > Settings > Advanced > REST
# API > Add key (read/write), or a WordPress user and an application password, created under
# Users > Profile > Application Passwords. Over plain HTTP only the second kind works, because
# WooCommerce's own authentication requires SSL for its keys.
WP_CONSUMER_KEY=
WP_CONSUMER_SECRET=

# The contact form's mail provider, and the only optional credential here.
#
# Unset, the contact page still works: the form is shown, the direct address is printed beside it,
# and a submission is answered honestly rather than silently lost - the route replies 503 and the
# form offers to open the message in the visitor's own mail client. Set, the form sends for real.
#
# Resend is the provider this was written against: a free account, one key, and its HTTP API is
# called with `fetch`, so the app gains no dependency. Create the key at resend.com/api-keys and add
# it here and to the deployed environment (Vercel > Settings > Environment Variables) - it is read at
# request time, so no redeploy is needed for a change to it.
RESEND_API_KEY=

# Who the email is from, and who it goes to. Both optional.
#
# The default sender is Resend's shared `onboarding@resend.dev`, which can only deliver to the
# address that owns the account - which is this site's own inbox, so no verified domain is needed for
# the form to work. A domain you have verified at Resend can replace it at any time; until then,
# changing it to anything else makes the provider refuse the send.
#
# The recipient defaults to CONTACT_EMAIL in src/lib/site.ts, which is the address the contact page
# prints. Set it only if the two should differ.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
